<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:background="@drawable/tracker_widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Monthly Summary" android:textSize="16sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:textStyle="bold" android:paddingBottom="6dp" />
    <LinearLayout android:id="@+id/widget_totals" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="4dp" android:baselineAligned="false" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="@drawable/tracker_widget_metric_background">
            <TextView android:id="@+id/widget_income_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Income received" android:textSize="12sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:accessibilityHeading="true" />
            <TextView android:id="@+id/widget_income_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="18sp" android:textColor="@color/widget_income" android:includeFontPadding="false" android:textStyle="bold" android:breakStrategy="simple" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="4dp" android:baselineAligned="false" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="@drawable/tracker_widget_metric_background">
            <TextView android:id="@+id/widget_expenses_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Expenses paid" android:textSize="12sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:accessibilityHeading="true" />
            <TextView android:id="@+id/widget_expenses_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="18sp" android:textColor="@color/widget_expense" android:includeFontPadding="false" android:textStyle="bold" android:breakStrategy="simple" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="4dp" android:baselineAligned="false" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="@drawable/tracker_widget_metric_background">
            <TextView android:id="@+id/widget_savings_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Savings" android:textSize="12sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:accessibilityHeading="true" />
            <TextView android:id="@+id/widget_savings_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="18sp" android:textColor="@color/widget_accent" android:includeFontPadding="false" android:textStyle="bold" android:breakStrategy="simple" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open the app to load your summary." android:textSize="12sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:paddingBottom="3dp" />
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Not refreshed" android:textSize="11sp" android:textColor="@color/widget_text" android:includeFontPadding="false" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
        <Button android:id="@+id/widget_refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp" android:layout_margin="2dp" android:padding="4dp" android:background="@drawable/tracker_widget_button" android:text="Refresh ↗" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/widget_text" android:singleLine="false" android:includeFontPadding="false" android:maxLines="4" />
        <Button android:id="@+id/widget_privacy" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp" android:layout_margin="2dp" android:padding="4dp" android:background="@drawable/tracker_widget_button" android:text="Show" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/widget_text" android:singleLine="false" android:includeFontPadding="false" android:maxLines="4" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_entries" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone" android:baselineAligned="false">
        <Button android:id="@+id/widget_expense" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp" android:layout_margin="2dp" android:padding="4dp" android:background="@drawable/tracker_widget_expense_button" android:text="Add Expense" android:textAllCaps="false" android:textStyle="bold" android:textSize="14sp" android:textColor="@android:color/white" android:singleLine="false" android:includeFontPadding="false" android:maxLines="4" />
        <Button android:id="@+id/widget_income" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp" android:layout_margin="2dp" android:padding="4dp" android:background="@drawable/tracker_widget_income_button" android:text="Add Income" android:textAllCaps="false" android:textStyle="bold" android:textSize="14sp" android:textColor="@android:color/white" android:singleLine="false" android:includeFontPadding="false" android:maxLines="4" />
    </LinearLayout>
</LinearLayout>
