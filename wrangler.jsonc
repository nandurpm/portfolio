// FILE: wrangler.jsonc
// FILE PURPOSE: Cloudflare Workers static-asset configuration. Pages Functions require a separate Pages deployment.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-06-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
