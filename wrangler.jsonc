// FILE: wrangler.jsonc
// FILE PURPOSE: Cloudflare Workers/Pages configuration for serving the repository root as static assets with Pages Functions support.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-06-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
